{
  "name": "obsidian-template-clipboard",
  "version": "1.0.0",
  "description": "将选中或复制的数据按模板转换为固定格式并复制到剪贴板",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "template",
    "clipboard"
  ],
  "author": "MuaCherish",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.2",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "^5.4.5"
  }
}
